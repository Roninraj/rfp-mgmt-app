// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}



model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          String    @default("vendor") // "requester" or "vendor"
  companyName   String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations - A user who is a requester creates RFPs
  createdRfps   Rfp[]     @relation("RequesterRfps")
}

// Update your existing Rfp model to include requester
model Rfp {
  id              Int       @id @default(autoincrement())
  title           String
  descriptionRaw  String
  budget          Float?
  currency        String?   @default("USD")
  deliveryBy      DateTime?
  paymentTerms    String?
  requirements    Json?
  createdAt       DateTime  @default(now())
  
  // Add requester relation
  requesterId     Int?
  requester       User?     @relation("RequesterRfps", fields: [requesterId], references: [id], onDelete: SetNull)

  proposals       Proposal[]
  rfpVendors      RfpVendor[]
}

// Vendor model - link to User
model Vendor {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  contactPerson String?
  notes         String?

  proposals     Proposal[]
  rfpVendors    RfpVendor[]
}

model RfpVendor {
  id        Int   @id @default(autoincrement())
  rfp       Rfp   @relation(fields: [rfpId], references: [id])
  rfpId     Int
  vendor    Vendor @relation(fields: [vendorId], references: [id])
  vendorId  Int
  status    String @default("invited")
}

model Proposal {
  id               Int      @id @default(autoincrement())
  rfp              Rfp      @relation(fields: [rfpId], references: [id])
  rfpId            Int
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  vendorId         Int
  emailMessageId   String?
  parsedAt         DateTime?

  totalPrice       Float?
  currency         String?  @default("USD")
  deliveryDays     Int?
  warrantyMonths   Int?
  paymentTermsText String?
  lineItems        Json?
  rawExtracted     Json?

  score            ProposalScore?
}

model ProposalScore {
  id             Int       @id @default(autoincrement())
  proposal       Proposal  @relation(fields: [proposalId], references: [id])
  proposalId     Int       @unique
  priceScore     Float?
  deliveryScore  Float?
  warrantyScore  Float?
  overallScore   Float?
  explanation    String?
}